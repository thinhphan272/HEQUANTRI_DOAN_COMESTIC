@model List<DoAnHQT_DATABASE.Areas.Admin.Models.StaffViewModel>

@{
    ViewBag.Title = "Quản Lý Nhân Viên";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    :root {
        --hasaki-dark: #2d5f4f;
        --hasaki-light: #10b981;
        --bg-light: #f8f9fa;
        --text-muted: #6c757d;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f0f2f5;
    }

    /* Tiêu đề trang */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-weight: 700;
        color: var(--hasaki-dark);
        margin: 0;
    }

    /* Style cho Card */
    .custom-card {
        border: none;
        border-radius: 12px;
        background: white;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    /* Style cho Form Thêm mới */
    .create-section {
        background: linear-gradient(to right, #ffffff, #fcfcfc);
        border-left: 5px solid var(--hasaki-dark);
    }

    .form-floating > .form-control:focus {
        border-color: var(--hasaki-light);
        box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.25);
    }

    /* Style cho Nút bấm */
    .btn-hasaki {
        background-color: var(--hasaki-dark);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s;
    }

        .btn-hasaki:hover {
            background-color: #1a4236;
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-cancel {
        border: 1px solid #dee2e6;
        color: var(--text-muted);
        background: white;
        border-radius: 8px;
    }

        .btn-outline-cancel:hover {
            background: #f8f9fa;
            color: #333;
        }

    /* Style cho Table */
    .staff-table thead th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        border-bottom: 2px solid #e9ecef;
        padding: 1rem 1.5rem;
    }

    .staff-table tbody td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        color: #495057;
        font-weight: 500;
    }

    .staff-table tbody tr:hover {
        background-color: #f8fdfb; /* Màu nền xanh cực nhạt khi hover */
    }

    /* Avatar giả lập */
    .avatar-circle {
        width: 40px;
        height: 40px;
        background-color: rgba(16, 185, 129, 0.1);
        color: var(--hasaki-dark);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-right: 15px;
        font-size: 1.1rem;
    }

    /* Nút xóa trong bảng */
    .btn-action-delete {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #dc3545;
        background-color: rgba(220, 53, 69, 0.1);
        border: none;
        transition: all 0.2s;
    }

        .btn-action-delete:hover {
            background-color: #dc3545;
            color: white;
        }

    .locked-row {
        background-color: #fff5f5;
    }

    .avatar-circle.locked {
        background: #dc3545;
        color: white;
    }
</style>

<div class="container-fluid py-4">

    <div class="page-header">
        <div>
            <h3 class="page-title"><i class="fas fa-users-cog me-2"></i>Quản Lý Nhân Viên</h3>
            <p class="text-muted mb-0 small">Danh sách tài khoản nhân viên & trạng thái truy cập</p>
        </div>
        <button type="button" id="btnShowCreate" class="btn btn-hasaki shadow-sm">
            <i class="fas fa-user-plus me-2"></i>Thêm Nhân Viên Mới
        </button>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
        </div>
    }

    <div id="createStaffForm" class="custom-card create-section mb-4" style="display: none;">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-4 text-secondary">Thông tin tài khoản mới</h5>
            @using (Html.BeginForm("Create", "Account", FormMethod.Post, new { @class = "form-horizontal", area = "Admin" }))
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" id="Username" name="username" class="form-control" required placeholder="Nhập tên..." autocomplete="off" />
                            <label for="Username"><i class="fas fa-user me-2 text-muted"></i>Tên đăng nhập</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="password" id="Password" name="password" class="form-control" required placeholder="Nhập mật khẩu..." />
                            <label for="Password"><i class="fas fa-lock me-2 text-muted"></i>Mật khẩu</label>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end mt-4">
                    <button type="button" id="btnCancelCreate" class="btn btn-outline-cancel px-4">Hủy bỏ</button>
                    <button type="submit" class="btn btn-hasaki px-4"><i class="fas fa-check me-2"></i>Lưu tài khoản</button>
                </div>
            }
        </div>
    </div>

    <div class="custom-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table staff-table mb-0">
                    <thead>
                        <tr>
                            <th>Tài khoản</th>
                            <th class="text-center">Trạng thái (Server)</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                string firstLetter = !string.IsNullOrEmpty(item.Username) ? item.Username.Substring(0, 1).ToUpper() : "U";

                                <tr class="@(item.IsLocked ? "locked-row" : "")">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle @(item.IsLocked ? "locked" : "")">
                                                @firstLetter
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.Username</div>
                                                <small class="text-muted">Role: Nhân viên</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        @if (item.IsLocked)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                                <i class="fas fa-lock me-1"></i> Đã khóa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                                <i class="fas fa-check-circle me-1"></i> Hoạt động
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            @if (item.IsLocked)
                                            {
                                                <a href="@Url.Action("Unlock", "Account", new { username = item.Username, area = "admin" })"
                                                   class="btn btn-sm btn-success" title="Mở khóa truy cập"
                                                   style="display: flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 8px;">
                                                    <i class="fas fa-lock-open"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("Lock", "Account", new { username = item.Username, area = "admin" })"
                                                   class="btn-action-delete ms-auto"
                                                   title="Khóa tài khoản này"
                                                   onclick="return confirm('Bạn có chắc chắn muốn KHÓA quyền truy cập của @item.Username?');">
                                                    <i class="fas fa-user-lock"></i>
                                                </a>
                                            }

                                            <a href="@Url.Action("Delete", "Account", new { username = item.Username, area = "admin" })"
                                               class="btn btn-sm btn-outline-secondary" title="Xóa vĩnh viễn"
                                               style="display: flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 8px;"
                                               onclick="return confirm('CẢNH BÁO: Hành động này sẽ xóa vĩnh viễn User khỏi Database. Bạn có chắc không?');">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        const createForm = $('#createStaffForm');
        const btnShow = $('#btnShowCreate');
        const btnCancel = $('#btnCancelCreate');

        btnShow.on('click', function () {
            createForm.slideToggle(400, function () {
                if (createForm.is(':visible')) { $('#Username').focus(); }
            });
            if ($(this).hasClass('active-toggle')) {
                $(this).removeClass('active-toggle').html('<i class="fas fa-user-plus me-2"></i>Thêm Nhân Viên Mới');
            } else {
                $(this).addClass('active-toggle').html('<i class="fas fa-minus me-2"></i>Đóng Form');
            }
        });

        btnCancel.on('click', function () {
            createForm.slideUp(400);
            btnShow.removeClass('active-toggle').html('<i class="fas fa-user-plus me-2"></i>Thêm Nhân Viên Mới');
        });
    });
</script>