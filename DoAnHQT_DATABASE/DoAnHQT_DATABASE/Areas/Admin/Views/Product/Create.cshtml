
@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
    
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tiny.cloud/1/ntjn1x7xodddb5xd6aojdl4pncz9ufjf77rzij4cz6ooerjt/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

@model DoAnHQT_DATABASE.Models.Product

<div class="container-fluid px-4">
    @if (TempData["AddError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["AddError"].ToString()
        </div>
    }

    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="mt-4">Thêm sản phẩm mới</h2>
        <a href="@Url.Action("Index", "Product", new {area = "Admin"})" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <i class="fas fa-plus me-1"></i>
            Nhập thông tin sản phẩm
        </div>
        <div class="card-body">
            @using (Html.BeginForm("CreateOnSubmit", "Product", new { area = "Admin" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="row">
                    <div class="col-md-8">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="ProductName" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>

                                @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.ProductName)
                            </div>
                            <div class="col-md-6">
                                <label for="ProductTypeID" class="form-label fw-bold">Loại sản phẩm <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.ProductTypeID, ViewBag.ProductType as SelectList, new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.ProductTypeID)
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="BrandID" class="form-label fw-bold">Thương hiệu <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.BrandID, ViewBag.Brand as SelectList, new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.BrandID)
                            </div>
                            <div class="col-md-6">
                                <label for="Origin" class="form-label fw-bold">Xuất xứ</label>
                                @Html.TextBoxFor(model => model.Origin, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Origin)
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(model => model.Price, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Price)
                            </div>
                            <div class="col-md-4">
                                <label for="Quantity" class="form-label fw-bold">Số lượng nhập <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(model => model.Quantity, new { @class = "form-control", type = "number" })
                                @Html.ValidationMessageFor(model => model.Quantity)
                            </div>
                            <div class="col-md-4">
                                <label for="Capacity" class="form-label fw-bold">Dung tích</label>
                                @Html.TextBoxFor(model => model.Capacity, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Capacity)

                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="txtDescription" class="form-label fw-bold">Mô tả chi tiết</label>
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", id = "txtDescription", rows = "10" })
                            @Html.ValidationMessageFor(mode => mode.Description)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card mb-3">
                            <div class="card-header bg-light fw-bold">Hình ảnh sản phẩm <span class="text-danger">*</span></div>
                            <div class="card-body text-center">
                                <img id="imgPreview"
                                     src="~/Content/Images/no-image.png"
                                     class="img-fluid mb-3 border rounded"
                                     style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;" />

                                <label for="imageUploadFile" class="btn btn-outline-primary btn-sm w-100 mb-2">
                                    <i class="fas fa-upload me-1"></i> Chọn ảnh
                                </label>

                                <input type="file" name="ImageUpload" id="imageUploadFile" class="d-none" accept="image/*" onchange="previewImage(this)" required />

                                <small class="text-muted">Bắt buộc chọn ảnh bìa.</small>

                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="ExpirationDate" class="form-label fw-bold">Ngày hết hạn</label>
                            @Html.TextBoxFor(model => model.ExpirationDate, new { @class = "form-control", type = "date", id = "ExpirationDate" })
                            @Html.ValidationMessageFor(model => model.ExpirationDate)
                        </div>

                        <div class="card bg-light border-0">
                            <div class="card-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           value="1"
                                           style="cursor: pointer;" name="IsAvailable" />

                                    <label class="form-check-label fw-bold" for="IsAvailableSwitch">Kích hoạt ngay</label>
                                </div>

                                <div class="form-text mt-2" style="font-size: 0.85rem;">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Sản phẩm sẽ hiển thị ngay sau khi tạo.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="btn btn-light border me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-4 fw-bold">
                        <i class="fas fa-plus me-2"></i>Thêm mới
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    tinymce.init({
        selector: '#txtDescription',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
    });

    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imgPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }</script>

