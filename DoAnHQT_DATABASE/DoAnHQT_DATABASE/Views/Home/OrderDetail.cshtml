
@{
    ViewBag.Title = "OrderDetail";
}

<style>
    :root {
        --hasaki-green: #3b7357;
        --hasaki-green-hover: #2d5a44;
        --hasaki-light-green: #e8f5e9;
    }

    /* Cards */
    .card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 18px;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
    }

    /* Badge */
    .badge-home {
        background-color: var(--hasaki-green);
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: normal;
    }

    /* Status Badge */
    .status-badge {
        display: inline-block;
        padding: 8px 20px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 14px;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-confirmed {
        background-color: #cfe2ff;
        color: #084298;
    }

    .status-shipping {
        background-color: #e7d4f7;
        color: #6f42c1;
    }

    .status-delivered {
        background-color: #d1e7dd;
        color: #0a3622;
    }

    .status-cancelled {
        background-color: #f8d7da;
        color: #842029;
    }

    /* Product Item */
    .product-item {
        border-bottom: 1px solid #e0e0e0;
        padding: 15px 0;
    }

        .product-item:last-child {
            border-bottom: none;
        }

    .product-img {
        width: 80px;
        height: 80px;
        background-color: #f8f8f8;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
    }

    .product-brand {
        color: #666;
        font-size: 13px;
        font-weight: 600;
    }

    .product-name {
        color: #333;
        font-weight: 500;
        margin: 5px 0;
    }

    .product-size {
        color: #999;
        font-size: 13px;
    }

    /* Price */
    .price {
        color: var(--hasaki-green);
        font-weight: bold;
        font-size: 16px;
    }

    /* Order Summary */
    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        color: #666;
    }

        .summary-row.total {
            border-top: 2px solid #e0e0e0;
            padding-top: 15px;
            margin-top: 10px;
        }

            .summary-row.total .label {
                font-size: 16px;
                font-weight: bold;
                color: #333;
            }

            .summary-row.total .value {
                font-size: 24px;
                font-weight: bold;
                color: var(--hasaki-green);
            }

    /* Buttons */
    .btn-hasaki {
        background-color: var(--hasaki-green);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: 600;
        width: 100%;
        transition: background-color 0.3s;
    }

        .btn-hasaki:hover {
            background-color: var(--hasaki-green-hover);
            color: white;
        }

    .btn-link-hasaki {
        color: #007bff;
        text-decoration: none;
        font-size: 14px;
    }

        .btn-link-hasaki:hover {
            text-decoration: underline;
        }

    /* Icons */
    .icon-box {
        width: 24px;
        height: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--hasaki-green);
    }

    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }

    /* Info Text */
    .info-text {
        font-size: 12px;
        color: #666;
        line-height: 1.5;
    }

    .order-id {
        color: var(--hasaki-green);
        font-weight: 600;
    }
</style>

@model DoAnHQT_DATABASE.Models.Orders

<!-- Main Content -->
<div class="container mb-5" style="margin-top: 140px;">
    <!-- Page Title -->
    <div class="mb-4">
        <h2 class="h4 mb-2">Chi tiết đơn hàng</h2>
        <p class="text-muted mb-0">
            Mã đơn hàng: <span class="order-id">@Model.OrderID</span>
            <span class="mx-2">|</span>
            <span class="status-badge status-shipping">@Model.Status</span>
        </p>
    </div>

    <div class="row">
        <!-- Left Column -->
        <div class="col-lg-8">
            <!-- Order Info Card -->
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-clock icon-box me-2"></i>
                                <div>
                                    <div class="text-muted small">Ngày đặt hàng</div>
                                    <div class="fw-semibold">@Model.OrderDate</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-credit-card icon-box me-2"></i>
                                <div>
                                    <div class="text-muted small">Hình thức thanh toán</div>
                                    <div class="fw-semibold">@Model.UserPaymentMethod</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Address Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-geo-alt icon-box me-2"></i>
                        Địa chỉ nhận hàng
                    </h5>
                    <div class="d-flex align-items-start mb-2">
                        <i class="bi bi-person-fill text-muted me-2"></i>
                        <div>
                            <span class="fw-bold">@Model.Users.Name</span>
                            <span class="badge-home ms-2">Nhà riêng</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-start mb-2">
                        <i class="bi bi-telephone-fill text-muted me-2"></i>
                        <span>@Model.Users.SDT</span>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="bi bi-geo-alt-fill text-muted me-2"></i>
                        <span>@Model.Address</span>
                    </div>
                </div>
            </div>


            <!-- Order Items Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-box-seam icon-box me-2"></i>
                        Thông tin kiện hàng
                    </h5>

                    <!-- Product Item -->
                    @foreach (var item in Model.OrderDetail)
                    {
                        <div class="product-item">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <img src="@Url.Content("~/Content/Images/ProductIMG/" + item.Product.Image)" class="product-img">
                                </div>
                                <div class="col">
                                    <div class="product-brand">@item.Product.Brand.BrandName</div>
                                    <div class="product-name">@item.Product.ProductName</div>
                                    <div class="product-size">50ml</div>
                                </div>
                                <div class="col-auto text-end">
                                    <div class="text-muted mb-1">@item.Quantity × @item.UnitPrice.Value.ToString("N0") ₫</div>
                                    <div class="price">@item.TongTien.ToString("N0") ₫</div>
                                </div>
                            </div>
                        </div>
                    }


                </div>
            </div>
        </div>

        <!-- Right Column - Order Summary -->
        <div class="col-lg-4">
            <div class="sticky-sidebar">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Đơn hàng</h5>

                        <div class="summary-row">
                            <span>Tạm tính:</span>
                            <span class="fw-semibold">@Model.TongThanhTien.ToString("N0") ₫</span>
                        </div>

                        <div class="summary-row">
                            <span>Giảm giá:</span>
                            <span class="fw-semibold">-0 ₫</span>
                        </div>

                        <div class="summary-row">
                            <span>Phí vận chuyển:</span>
                            <span class="fw-semibold">0 ₫</span>
                        </div>

                        <div class="summary-row total">
                            <span class="label">Thành tiền (Đã VAT):</span>
                            <span class="value">@Model.TongThanhTien.ToString("N0") ₫</span>
                        </div>

                        <div class="info-text mt-3 mb-3">
                            Đã bao gồm VAT, phí đóng gói, phí vận chuyển và các chi phí khác
                            vui lòng xem <a href="#" class="text-primary">Chính sách vận chuyển</a>
                        </div>

                        <button class="btn btn-hasaki">
                            <i class="bi bi-truck me-2"></i>Theo dõi đơn hàng
                        </button>

                    </div>
                </div>

                <!-- Order Timeline -->
                <div class="card mt-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Trạng thái đơn hàng</h6>
                        <div class="timeline">

                            <div class="d-flex mb-3">
                                <div class="me-3">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">@Model.Status</div>
                                    <div class="text-muted small">@Model.OrderDate</div>
                                </div>
                            </div>
                            
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>