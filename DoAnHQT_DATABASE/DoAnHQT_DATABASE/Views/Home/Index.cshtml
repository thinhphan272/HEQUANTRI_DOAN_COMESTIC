@{
    ViewBag.Title = "Home Page";
}



<main>
    <div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel" style="margin-top: 123px">
        <div class="carousel-inner">
            <div class="carousel-item active" data-bs-interval="3000">
                <img style="border-radius: 0px" src="~/Content/Images/banner.jpg" class="d-block w-100" alt="ưu đãi">
            </div>
            <div class="carousel-item" data-bs-interval="3000">
                <img style="border-radius: 0px" src="~/Content/Images/banner2.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item" data-bs-interval="3000">
                <img style="border-radius: 0px" src="~/Content/Images/banner3.jpg" class="d-block w-100" alt="...">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleInterval" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleInterval" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    <div class="flash-deal mt-4 mb-4">
        <img src="Images/sale_70p.jpg" alt="hinh1" class="flash-deal-img" />
        <div class="flash-deal-content">
            <div class="flash-deal-header">
                <h2>SALE UP TO 70% OFF</h2>

            </div>
            <div class="flash-deal-timer">
                <div class="item">
                    <p id="days">Days</p>
                    <p>NGÀY</p>
                </div>
                <div class="item">
                    <p id="hours">Hours</p>
                    <p>GIỜ</p>
                </div>
                <div class="item">
                    <p id="minutes">Minutes</p>
                    <p>PHÚT</p>
                </div>
                <div class="item">
                    <p id="seconds">Seconds</p>
                    <p>GIÂY</p>
                </div>
            </div>

            <p class="end">Chương trình Sale đã kết thúc</p>
        </div>
    </div>

    <div class="row product-type-choice ">
        <div class="col-auto product-type-choice-item">
            <img class="product-type-choice-image" src="~/Content/Images/ProductIMG/mat-na-nghe-hung-yen-cocoon-giup-da-rang-ro-min-mang-100ml-3.jpg" />
        </div>
        <div class="col-auto product-type-choice-item">
            <img class="product-type-choice-image" src="~/Content/Images/ProductIMG/mat-na-nghe-hung-yen-cocoon-giup-da-rang-ro-min-mang-100ml-3.jpg" />

        </div>
        <div class="col-auto product-type-choice-item">
            <img class="product-type-choice-image" src="~/Content/Images/ProductIMG/mat-na-nghe-hung-yen-cocoon-giup-da-rang-ro-min-mang-100ml-3.jpg" />

        </div>
        <div class="col-auto product-type-choice-item">
            <img class="product-type-choice-image" src="~/Content/Images/ProductIMG/mat-na-nghe-hung-yen-cocoon-giup-da-rang-ro-min-mang-100ml-3.jpg" />

        </div>
        <div class="col-auto product-type-choice-item">
            <img class="product-type-choice-image" src="~/Content/Images/ProductIMG/mat-na-nghe-hung-yen-cocoon-giup-da-rang-ro-min-mang-100ml-3.jpg" />

        </div>
        <div class="col-auto product-type-choice-item">
            <img class="product-type-choice-image" src="~/Content/Images/ProductIMG/mat-na-nghe-hung-yen-cocoon-giup-da-rang-ro-min-mang-100ml-3.jpg" />

        </div>

    </div>
</main>