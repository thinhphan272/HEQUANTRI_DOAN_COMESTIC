@{
    ViewBag.Title = "Home Page";
}

<div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel" style="margin-top: 123px">
    <div class="carousel-inner">
        <div class="carousel-item active" data-bs-interval="3000">
            <img style="border-radius: 0px" src="~/Content/Images/banner.jpg" class="d-block w-100" alt="ưu đãi">
        </div>
        <div class="carousel-item" data-bs-interval="3000">
            <img style="border-radius: 0px" src="~/Content/Images/banner2.jpg" class="d-block w-100" alt="...">
        </div>
        <div class="carousel-item" data-bs-interval="3000">
            <img style="border-radius: 0px" src="~/Content/Images/banner3.jpg" class="d-block w-100" alt="...">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleInterval" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleInterval" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<main class="" style="width: 1300px; margin: 0 auto">

    <div class=" flash-deal mt-4 mb-4" style="background-color: #FF8E4D">

        <div class="flash-deal-content">
            <div class="flash-deal-header">
