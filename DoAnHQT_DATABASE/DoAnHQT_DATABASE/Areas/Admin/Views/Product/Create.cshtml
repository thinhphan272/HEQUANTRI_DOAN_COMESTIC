
@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tiny.cloud/1/ntjn1x7xodddb5xd6aojdl4pncz9ufjf77rzij4cz6ooerjt/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="mt-4">Thêm sản phẩm mới</h2>
        <a href="@Url.Action("Index", "Product", new {area = "Admin"})" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <i class="fas fa-plus me-1"></i>
            Nhập thông tin sản phẩm
        </div>
        <div class="card-body">
            <form action="/Admin/Product/Create" method="post" enctype="multipart/form-data">

                <div class="row">
                    <div class="col-md-8">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="ProductName" class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="ProductName" name="ProductName"
                                       placeholder="Nhập tên sản phẩm" required>
                            </div>
                            <div class="col-md-6">
                                <label for="ProductTypeID" class="form-label fw-bold">Loại sản phẩm <span class="text-danger">*</span></label>
                                <select class="form-select" id="ProductTypeID" name="ProductTypeID" required>
                                    <option value="">-- Chọn loại --</option>
                                    <option value="1">Dầu gội - Dầu xả</option>
                                    <option value="2">Sữa rửa mặt</option>
                                    <option value="3">Toner - Nước hoa hồng</option>
                                    <option value="4">Kem chống nắng</option>
                                    <option value="5">Serum - Tinh chất</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="BrandID" class="form-label fw-bold">Thương hiệu <span class="text-danger">*</span></label>
                                <select class="form-select" id="BrandID" name="BrandID" required>
                                    <option value="">-- Chọn thương hiệu --</option>
                                    <option value="BR01">Cocoon</option>
                                    <option value="BR02">La Roche-Posay</option>
                                    <option value="BR03">Cerave</option>
                                    <option value="BR04">L'Oreal Paris</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="Origin" class="form-label fw-bold">Xuất xứ</label>
                                <input type="text" class="form-control" id="Origin" name="Origin" placeholder="VD: Việt Nam">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="Price" name="Price" min="0" required>
                            </div>
                            <div class="col-md-4">
                                <label for="Quantity" class="form-label fw-bold">Số lượng nhập <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="Quantity" name="Quantity" min="1" value="1" required>
                            </div>
                            <div class="col-md-4">
                                <label for="Capacity" class="form-label fw-bold">Dung tích</label>
                                <input type="text" class="form-control" id="Capacity" name="Capacity" placeholder="VD: 500ml">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="txtDescription" class="form-label fw-bold">Mô tả chi tiết</label>
                            <textarea class="form-control" id="txtDescription" name="Description" rows="10"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card mb-3">
                            <div class="card-header bg-light fw-bold">Hình ảnh sản phẩm <span class="text-danger">*</span></div>
                            <div class="card-body text-center">
                                <img id="imgPreview"
                                     src="~/Content/Images/no-image.png"
                                     class="img-fluid mb-3 border rounded"
                                     style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;" />

                                <label for="imageUploadFile" class="btn btn-outline-primary btn-sm w-100 mb-2">
                                    <i class="fas fa-upload me-1"></i> Chọn ảnh
                                </label>
                                <input type="file" name="ImageUpload" id="imageUploadFile" class="d-none" accept="image/*" onchange="previewImage(this)" required />
                                <small class="text-muted">Bắt buộc chọn ảnh bìa.</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="ExpirationDate" class="form-label fw-bold">Ngày hết hạn</label>
                            <input type="date" class="form-control" id="ExpirationDate" name="ExpirationDate">
                        </div>

                        <div class="card bg-light border-0">
                            <div class="card-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="IsAvailableSwitch" name="IsAvailable" checked style="cursor: pointer;">
                                    <label class="form-check-label fw-bold" for="IsAvailableSwitch">Kích hoạt ngay</label>
                                </div>
                                <div class="form-text mt-2" style="font-size: 0.85rem;">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Sản phẩm sẽ hiển thị ngay sau khi tạo.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <a href="@Url.Action("Index", "Product", new {area = "Admin"})" class="btn btn-light border me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-4 fw-bold">
                        <i class="fas fa-plus me-2"></i>Thêm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>tinymce.init({
        selector: '#txtDescription',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
    });

    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imgPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }</script>

