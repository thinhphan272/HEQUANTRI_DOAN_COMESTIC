# Bỏ qua thư mục tạm của Visual Studio (QUAN TRỌNG)

packages/
.vs/
**/.vs/

# Bỏ qua thư mục kết quả build (QUAN TRỌNG)
bin/
obj/
**/bin/
**/obj/

