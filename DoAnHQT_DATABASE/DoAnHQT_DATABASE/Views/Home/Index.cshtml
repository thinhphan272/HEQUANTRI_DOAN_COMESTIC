@section Scripts {


    <script type="text/javascript">
        $(document).ready(function () {
            $('.flash-deal-product-container').slick({
                infinite: true,      // Cho phép lặp vô hạn
                slidesToShow: 5,     // Hiển thị 5 sản phẩm cùng lúc
                slidesToScroll: 1,   // Trượt 1 sản phẩm mỗi lần
                autoplay: true,      // Tự động trượt
                autoplaySpeed: 5000, // Tốc độ trượt (10000ms = 10 giây)
                arrows: true,        // Hiển thị nút mũi tên next/prev
                dots: false          // Ẩn các dấu chấm (dots)
            });
        });
    </script>
}