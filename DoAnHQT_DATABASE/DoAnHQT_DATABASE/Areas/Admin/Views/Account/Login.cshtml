@{
    ViewBag.Title = "Đăng Nhập Quản Trị";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Khai báo màu chuẩn Hasaki để dùng chung */
            --hasaki-dark: #2d5f4f; /* Màu xanh đậm chủ đạo */
            --hasaki-light: #42b983; /* Màu xanh lá tươi */
            --hasaki-bg-gradient-start: rgba(45, 95, 79, 0.9); /* Màu phủ đậm */
            --hasaki-bg-gradient-end: rgba(45, 95, 79, 0.2); /* Màu phủ nhạt (để thấy ảnh) */
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f0f2f5;
            height: 100vh;
            overflow: hidden;
        }

        .login-container {
            height: 100vh;
            width: 100%;
        }

        /* --- CỘT TRÁI: HÌNH ẢNH & LỚP PHỦ --- */
        .login-image {
            /* Ảnh nền Hasaki Clinic */
            background-image: url('https://media.hasaki.vn/hsk/hasaki-clinic-quan-tan-phu.jpg');
            background-size: cover;
            background-position: center;
            position: relative;
        }

            .login-image::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                /* QUAN TRỌNG: Gradient từ Trái (Đậm) sang Phải (Nhạt dần/Trong suốt) */
                background: linear-gradient(to right, var(--hasaki-bg-gradient-start) 0%, var(--hasaki-bg-gradient-end) 100%);
            }

        .login-quote {
            position: absolute;
            bottom: 15%; /* Đẩy lên cao một chút cho cân đối */
            left: 8%;
            right: 20%; /* Chừa khoảng trống bên phải để thấy ảnh rõ hơn */
            color: white;
            z-index: 2;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3); /* Thêm bóng chữ để dễ đọc trên nền ảnh */
        }

            .login-quote h2 {
                font-weight: 700;
                margin-bottom: 1rem;
                border-left: 5px solid #fff; /* Đường kẻ trắng trang trí */
                padding-left: 15px;
            }

        /* --- CỘT PHẢI: FORM ĐĂNG NHẬP --- */
        .login-form-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            padding: 40px;
        }

        .login-content {
            width: 100%;
            max-width: 420px;
        }

        .brand-logo {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--hasaki-dark); /* Màu xanh Hasaki */
            margin-bottom: 5px;
            display: inline-block;
            letter-spacing: -1px;
        }

        .welcome-text {
            color: #8898aa;
            margin-bottom: 35px;
            font-size: 0.95rem;
        }

        /* Custom Input Fields */
        .form-floating > .form-control {
            border-radius: 8px;
            border: 1px solid #e9ecef;
            background-color: #fcfcfc;
            padding-left: 20px; /* Thụt vào một chút */
            height: 55px;
        }

            /* Hiệu ứng khi bấm vào ô input: Viền xanh Hasaki */
            .form-floating > .form-control:focus {
                border-color: var(--hasaki-light);
                box-shadow: 0 0 0 0.25rem rgba(66, 185, 131, 0.15); /* Bóng xanh nhạt */
                background-color: white;
            }

        .form-floating > label {
            padding-left: 20px;
            color: #adb5bd;
        }

        .input-icon-right {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #ced4da;
            z-index: 4;
        }

        /* Custom Dropdown */
        .custom-select {
            height: 55px;
            border-radius: 8px;
            border: 1px solid #e9ecef;
            background-color: #fcfcfc;
            padding-left: 20px;
            cursor: pointer;
        }

            .custom-select:focus {
                border-color: var(--hasaki-light);
                box-shadow: 0 0 0 0.25rem rgba(66, 185, 131, 0.15);
            }

        /* Button Styling - Gradient Xanh Hasaki */
        .btn-login {
            background: linear-gradient(to right, var(--hasaki-dark), var(--hasaki-light));
            border: none;
            border-radius: 30px; /* Bo tròn hơn cho hiện đại */
            padding: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            color: white;
            width: 100%;
            margin-top: 25px;
            box-shadow: 0 5px 15px rgba(45, 95, 79, 0.2);
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(45, 95, 79, 0.3);
                /* Đảo chiều gradient nhẹ khi hover */
                background: linear-gradient(to right, var(--hasaki-light), var(--hasaki-dark));
            }

        .forgot-link {
            color: var(--hasaki-dark);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

            .forgot-link:hover {
                color: var(--hasaki-light);
            }

        .alert-custom {
            border-radius: 8px;
            font-size: 0.9rem;
            border: none;
            background-color: #fee2e2;
            color: #991b1b;
        }
    </style>
</head>
<body>

    <div class="container-fluid p-0">
        <div class="row g-0 login-container">
            <div class="col-md-7 col-lg-8 d-none d-md-block login-image">
                <div class="login-quote">
                    <h2>Hệ Thống Quản Trị</h2>
                    <p class="fs-5">Chất lượng thật - Giá trị thật. <br>Quản lý vận hành chuyên nghiệp cùng Hasaki.</p>
                </div>
            </div>

            <div class="col-md-5 col-lg-4 login-form-wrap">
                <div class="login-content">
                    <div class="text-center mb-4">
                        <div class="brand-logo">Hasaki.vn</div>
                        <h5 class="fw-bold" style="color: #4a5568;">Admin Dashboard</h5>
                        <p class="welcome-text">Đăng nhập để bắt đầu phiên làm việc</p>
                    </div>

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal", area = "admin" }))
                    {
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger alert-custom mb-4" })

                        <div class="form-floating mb-3 position-relative">
                            <input type="text" name="username" class="form-control" id="floatingInput" placeholder="Tên đăng nhập" required>
                            <label for="floatingInput">Tên đăng nhập</label>
                            <i class="fas fa-user input-icon-right"></i>
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            <input type="password" name="password" class="form-control" id="floatingPassword" placeholder="Mật khẩu" required>
                            <label for="floatingPassword">Mật khẩu</label>
                            <i class="fas fa-lock input-icon-right"></i>
                        </div>

                        <div class="mb-3 position-relative">
                            <label class="form-label text-muted small fw-bold ms-1" style="font-size: 0.75rem; text-transform: uppercase;">Vai trò truy cập</label>
                            @Html.DropDownList("Role",
                                new SelectList(new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Quản trị viên (Admin)", Value = "Admin" },
                                    new SelectListItem { Text = "Nhân viên", Value = "Nhân viên" }
                                }, "Value", "Text"),
                                new { @class = "form-select custom-select" }
                            )
                        </div>

                        if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger alert-custom d-flex align-items-center mt-3" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <div>@ViewBag.Error</div>
                            </div>
                        }

                        <button type="submit" class="btn btn-login">
                            ĐĂNG NHẬP <i class="fas fa-arrow-right ms-2"></i>
                        </button>

                        <div class="text-center mt-4">
                            <span class="text-muted small">Quên mật khẩu? <a href="#" class="forgot-link">Liên hệ IT</a></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>