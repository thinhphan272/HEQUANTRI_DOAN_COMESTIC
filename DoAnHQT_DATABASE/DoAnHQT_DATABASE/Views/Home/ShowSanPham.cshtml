@section Scripts {
    <script>
        // Đợi cho đến khi toàn bộ trang được tải xong
        document.addEventListener("DOMContentLoaded", function () {

            // ===== 1. MÃ CHO DANH MỤC (TỪ KHỐI ĐẦU TIÊN) =====
            const categoryItems = document.querySelectorAll('.category-item');

            categoryItems.forEach(item => {
                const link = item.querySelector('.category-item_link');
                link.addEventListener('click', function (e) {
                    e.preventDefault(); // Ngăn hành vi mặc định (tải lại trang)

                    // Kiểm tra xem mục này đã active chưa
                    const wasActive = item.classList.contains('category-item-active');

                    // 1. Tắt active của TẤT CẢ các mục
                    categoryItems.forEach(i => {
                        i.classList.remove('category-item-active');
                    });

                    // 2. Bật active cho mục vừa click
                    if (!wasActive) {
                        item.classList.add('category-item-active');
                    }
                });
            });

            // ===== 2. MÃ MỚI CHO NÚT YÊU THÍCH (Trái tim) (TỪ KHỐI THỨ HAI) =====
            const likeButtons = document.querySelectorAll('.home-product-item_like');

            likeButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    // **Rất quan trọng:** Ngăn không cho click vào trái tim
                    // bị coi là click vào thẻ <a> bọc ngoài sản phẩm.
                    e.preventDefault();
                    e.stopPropagation(); // Ngăn sự kiện lan truyền thêm

                    // Tự động Thêm/Xóa class 'home-product-item_like-liked'
                    this.classList.toggle('home-product-item_like-liked');
                });
            });

            // ===== HẾT MÃ =====

        });
    </script>
}