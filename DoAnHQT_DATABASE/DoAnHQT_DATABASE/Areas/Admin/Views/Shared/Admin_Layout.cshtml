<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Hasaki Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 260px;
            --header-height: 70px;
            --hasaki-dark: #1a4236; /* Xanh đậm làm nền Sidebar */
            --hasaki-green: #10b981; /* Xanh tươi làm điểm nhấn */
            --hasaki-hover: #2d5f4f; /* Màu khi hover */
            --bg-body: #f3f4f6;
            --text-light: #e2e8f0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-body);
            overflow-x: hidden;
        }

        /* --- 1. SIDEBAR --- */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--hasaki-dark);
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 10px rgba(0,0,0,0.1);
        }

        .sidebar-brand {
            height: var(--header-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }

            .sidebar-brand img {
                height: 35px;
                margin-right: 12px;
            }

        .sidebar-menu {
            padding: 1rem 0;
            flex-grow: 1;
            overflow-y: auto;
        }

            /* Thanh cuộn cho sidebar */
            .sidebar-menu::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar-menu::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.2);
                border-radius: 3px;
            }

        .nav-item {
            padding: 0 1rem;
            margin-bottom: 5px;
        }

        .nav-link {
            color: var(--text-light);
            padding: 0.8rem 1rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            transition: all 0.2s;
            font-weight: 500;
            font-size: 0.95rem;
        }

            .nav-link i {
                width: 25px;
                font-size: 1.1rem;
                margin-right: 10px;
                text-align: center;
            }

            .nav-link:hover {
                background-color: var(--hasaki-hover);
                color: white;
                transform: translateX(5px);
            }

            .nav-link.active {
                background-color: var(--hasaki-green);
                color: white;
                box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
            }

        /* --- 2. HEADER TOP --- */
        .main-header {
            height: var(--header-height);
            background: white;
            position: fixed;
            top: 0;
            right: 0;
            left: var(--sidebar-width);
            z-index: 999;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            box-shadow: 0 2px 15px rgba(0,0,0,0.04);
            transition: all 0.3s;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: var(--hasaki-green);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* --- 3. MAIN CONTENT --- */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            margin-top: var(--header-height);
            min-height: calc(100vh - var(--header-height));
        }

        /* Nút Logout */
        .logout-section {
            padding: 1rem;
            border-top: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
        }

        .btn-logout {
            width: 100%;
            background: rgba(239, 68, 68, 0.1);
            color: #fca5a5;
            border: none;
            padding: 10px;
            border-radius: 8px;
            transition: 0.2s;
            text-decoration: none;
            display: block;
            text-align: center;
        }

            .btn-logout:hover {
                background: #ef4444;
                color: white;
            }
    </style>
</head>
<body>
    @{
        // Lấy controller hiện tại để active menu
        var controllerObj = ViewContext.RouteData.Values["controller"];
        string currentController = (controllerObj != null ? controllerObj.ToString() : "").ToLower();

        var roleObj = Session["Role"];
        string role = (roleObj != null ? roleObj.ToString() : "");
        string empName = Session["EmployeeName"] != null ? Session["EmployeeName"].ToString() : "Admin";
        string avatarChar = !string.IsNullOrEmpty(empName) ? empName.Substring(0, 1).ToUpper() : "U";
    }

    <nav class="sidebar">
        <div class="sidebar-brand">
            <img src="https://hasaki.vn/images/graphics/logo_site_2024.png" alt="Hasaki Logo" style="height: 30px; object-fit: contain; filter: brightness(0) invert(1);">
            <span class="ms-2" style="font-size: 1.2rem;">ADMIN</span>
        </div>

        <div class="sidebar-menu">
            <ul class="nav flex-column">

        <h4 class="mb-0">Hasaki Admin</h4>
        @if (role == "Admin")
        {
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard", new {area = "admin"})"><i class="fas fa-chart-line me-2"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "product" ? "active" : "")" href="@Url.Action("Index", "Product", new {area = "admin"})"><i class="fas fa-seedling me-2"></i> Quản lý sản phẩm</a>
                </li>
                <li class="nav-item @(currentController == "order" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "Order", new {area = "admin"})"><i class="fas fa-shopping-cart me-2"></i> Quản lý đơn hàng</a>
                </li>
                <li class="nav-item @(currentController == "user" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "User", new {area = "admin"})"><i class="fas fa-users me-2"></i> Quản lý khách hàng</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "account" ? "active" : "")" href="@Url.Action("Index", "Account", new {area = "admin"})"><i class="fa-solid fa-person me-2"></i> Quản lý nhân viên</a>
                </li>
                <li class="nav-item @(currentController == "discount" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "Discount", new {area = "admin"})"><i class="fas fa-tags me-2"></i> Quản lý khuyến mãi</a>
                </li>
                <li class="nav-item @(currentController == "goodsreceiptnote" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "GoodsReceiptNote", new {area = "admin"})"><i class="bi bi-card-checklist me-2"></i> Quản lý phiếu nhập</a>
                </li>
                <li class="nav-item @(currentController == "backup" ? "active" : "")">
                    <a class="nav-link" href="@Url.Action("Index", "Backup", new {area = "admin"})">
                        <i class="fa-solid fa-database me-2"></i> Backup & Restore
                    </a>
                </li>
            </ul>
            <ul class="nav flex-column">
                <li class="nav-item mt-auto">
                    <a class="nav-link" href="@Url.Action("Logout", "Account", new {area = "admin"})"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a>
                </li>
            </ul>
        }

        else if (role == "Nhân viên")
        {
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "product" ? "active" : "")" href="@Url.Action("Index", "Product", new {area = "admin"})"><i class="fas fa-seedling me-2"></i> Quản lý sản phẩm</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "order" ? "active" : "")" href="@Url.Action("Index", "Order", new {area = "admin"})"><i class="fas fa-shopping-cart me-2"></i> Quản lý đơn hàng</a>
                </li>
               
            </ul>
            <ul class="nav flex-column">
                <li class="nav-item mt-auto">
                    <a class="nav-link" href="@Url.Action("Logout", "Account", new {area = "admin"})"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a>
                </li>
            </ul>
        }
        else
        {


            </ul>
        </div>

        @if (!string.IsNullOrEmpty(role))
        {
            <div class="logout-section">
                <a href="@Url.Action("Logout", "Account", new {area = "admin"})" class="btn-logout">
                    <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                </a>
            </div>
        }
    </nav>

    <header class="main-header">
        <div class="d-flex align-items-center">
            <h5 class="mb-0 text-dark fw-bold">@ViewBag.Title</h5>
        </div>

        <div class="user-profile">
            <div class="text-end d-none d-sm-block">
                <div class="fw-bold text-dark">@empName</div>
                <div class="text-muted small" style="font-size: 0.8rem;">@role</div>
            </div>
            <div class="user-avatar shadow-sm">
                @avatarChar
            </div>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</body>
</html>