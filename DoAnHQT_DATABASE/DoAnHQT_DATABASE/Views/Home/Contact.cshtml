                <div class="col-6 col-md-4 col-lg-3 col-xl-15">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="service-title">Chính sách<br>bảo hành<br>Havatek</div>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-lg-3 col-xl-15">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="bi bi-arrow-repeat"></i>
