
@{
    ViewBag.Title = "HienThiDanhMuc";
}

@model List<DoAnHQT_DATABASE.Models.ProductType>

<nav class="category">
    <h4 class="category_heading">
        <i class="category_heading-icon fa-solid fa-list"></i>
        Danh mục
    </h4>
    <ul class="category-list">
        <li class="category-item category-item">

            <a href="@Url.Action("TimTheoLoai", "Home", new {id=Model[0].ProductTypeID.Trim()})" class="category-item_link">
                @Model[0].ProductTypeName
            </a>
        </li>
        @foreach (var item in Model.Skip(1))
        {
            <li class="category-item">
                <a href="@Url.Action("TimTheoLoai", "Home", new {id=item.ProductTypeID.Trim()})" class="category-item_link">
                    @item.ProductTypeName
                </a>
            </li>
        }

    </ul>
</nav>