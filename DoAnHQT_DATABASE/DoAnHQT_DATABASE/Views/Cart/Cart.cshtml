
@{
    ViewBag.Title = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int soSanPham = Model.ShoppingCartItem.Count();
}

@model DoAnHQT_DATABASE.Models.ShoppingCart

<div class="cart-container-shop" style="margin-top: 130px !important; width: 1300px; margin: 0 auto">
    <h5>Giỏ hàng <span style="color: rgb(153, 153, 153)">(@soSanPham sản phẩm)</span></h5>
    <div class="row">
        <div class="col-md-9">

            @if (soSanPham == 0)
            {
                <div class="not-have-product-in-cart" style="margin: 0 auto;">
                    <div style="width: 400px; margin: 0 auto;">
                        <img width="100%" src="@Url.Content("/Content/Images/no_cart.png")" />
                    </div>

                    <div class="not-have-product-in-cart-label" style="margin: 0 auto; text-align: center;">
                        Bạn chưa có sản phẩm nào trong giỏ hàng
                    </div>
                    <hr />
                </div>
            }
            else
            {
                <table class="table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Sản phẩm</th>
                            <th scope="col">Giá tiền</th>
                            <th scope="col" class="text-center">Số lượng</th>
                            <th scope="col" class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ShoppingCartItem)
                        {
                            <tr>
                                <td class="align-middle" style="width: 600px;">
                                    <div class="row cart-item">
                                        <div class="col-md-2">
                                            <div class="cart-item-image">
                                                <img width="100%" src="@Url.Content("~/Content/Images/ProductIMG/" + item.Product.Image)" />
                                            </div>
                                        </div>
                                        <div class="col-md-10">
                                            <h6 class="cart-item-brand">
                                                <a href="@Url.Action("TimTheoBrand", "Home", new {id = item.Product.BrandID.Trim()})"  style="text-decoration: none; color: var(--primary-color)">
                                                    @item.Product.Brand.BrandName
                                                </a>
                                            </h6>
                                            <span class="cart-item-name">
                                                <a href="@Url.Action("SanPhamDetail", "Home", new {id = item.ProductID.Trim()})"  style="text-decoration: none; color:black">
                                                    @item.Product.ProductName<br />@item.Product.Capacity.ToString()ml
                                                </a>
                                            </span>
                                            <br />

                                            <div class="like-and-delete">

                                                <span class="home-product-item_like home-product-item_like-liked">
                                                    <i class="home-product-item_like-icon-empty fa-regular fa-heart"></i>
                                                    <i class="home-product-item_like-icon-fill fa fa-heart"></i>
                                                    Yêu thích
                                                </span>
                                                <!--Nút xóa-->
                                                <div class="btn cart-delete-item">
                                                    <a href="@Url.Action("XoaTrongGio", "Cart", new {productID = item.ProductID.Trim()})" style="text-decoration:none; color: black">
                                                        <i class="fa fa-x" style="color: var(--primary-color)"></i> Xóa
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle ">@item.Product.Price.Value.ToString("N0")đ</td>
                                <td class="align-middle">
                                    <div class="quantity-content">
                                        <!--Nút tăng giảm số lượng-->
                                        <div class="quantity-number">
                                            @item.Quantity
                                        </div>
                                        <div class="quantity-btn">
                                            <div class="quantity-btn-icon">
                                                <a href="@Url.Action("UpdateSoLuong", "Cart", new {productID=item.ProductID, type=1})">
                                                    <i class="fa-solid fa-caret-up " style="color: black">
                                                    </i>
                                                </a>
                                            </div>
                                            <div class="quantity-btn-icon">
                                                <a href="@Url.Action("UpdateSoLuong", "Cart", new {productID=item.ProductID, type=-1})">
                                                    <i class="fa-solid fa-caret-down" style="color: black">
                                                    </i>
                                                </a>
                                            </div>

                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle text-end">
                                    @((item.Quantity * item.Product.GiaDaGiam).Value.ToString("N0"))đ
                                </td>
                            </tr>

                        }

                    </tbody>
                </table>
            }



            <a href="@Url.Action("ShowSanPham", "Home")" class=" btn continue-shopping">
                <i class="fa fa-arrow-left"></i>
                Tiếp tục mua hàng
            </a>

        </div>

        <div class="col-md-3" style="border-top: 2px solid var(--primary-color); padding: 0;">
            <div class="cart-pay-header">
                <span class="cart-pay-header-content">Hóa đơn của bạn</span>
            </div>
            <div class="cart-pay-body">
                <div class="cart-pay-total">
                    <div class="cart-pay-total-label">Tạm tính:</div>
                    <div class="cart-pay-total-money">@Model.TongThanhTien.ToString("N0") đ</div>

                </div>
                <div class="cart-pay-discount">
                    <div class="cart-pay-discount-label">Giảm giá:</div>
                    <div class="cart-pay-discount-money">0 đ</div>

                </div>
                <hr style="margin: 10px 0;" />
                <div class="cart-total-after-discount">
                    <div class="cart-total-after-discount-label">Tổng cộng:</div>
                    <div class="cart-total-after-discount-money">@Model.TongThanhTien.ToString("N0") đ</div>
                </div>
                <div class="VAT">(Đã bao gồm VAT)</div>
                <a href="@Url.Action("PaymentPage", "Cart")" class="btn proceed-to-order w-100">Tiến hành đặt hàng</a>
            </div>
        </div>
    </div>

</div>