                </div>

                <div class="col-6 col-md-4 col-lg-3 col-xl-15">
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>
                        <div class="service-title">Tuyển dụng</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="container">
            <h2 class="section-title">Câu hỏi thường gặp</h2>
            <div class="row">
                <div class="col-md-6">
                    <div class="faq-item">Đăng ký thành viên Hasaki như thế nào?</div>
