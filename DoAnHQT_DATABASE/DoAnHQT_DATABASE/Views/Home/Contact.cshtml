
@{
    ViewBag.Title = "Contact";
}

<style>
    :root {
            --hasaki-green: #3b7357;
            --hasaki-green-hover: #2d5a44;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, #3b7357 0%, #2d5a44 100%);
            color: white;
            padding: 60px 0;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -10%;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
        }

        .hero-section::after {
            content: '';
            position: absolute;
            bottom: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
        }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .hero-title {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 30px;
            text-align: center;
        }

        /* Search Box */
        .search-box {
            max-width: 800px;
            margin: 0 auto 30px;
            position: relative;
        }

        .search-input {
            border: none;
            border-radius: 50px;
            padding: 18px 60px 18px 25px;
            font-size: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .search-input:focus {
            outline: none;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .search-btn {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background-color: var(--hasaki-green);
            border: none;
            border-radius: 50%;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            transition: background-color 0.3s;
        }

        .search-btn:hover {
            background-color: var(--hasaki-green-hover);
        }

        /* Contact Buttons */
        .contact-buttons {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
        }

        .contact-btn {
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            border: 2px solid white;
            border-radius: 30px;
            padding: 12px 30px;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
            backdrop-filter: blur(10px);
        }

        .contact-btn:hover {
            background-color: white;
            color: var(--hasaki-green);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .contact-btn i {
            font-size: 20px;
        }

        /* Service Icons Section */
        .services-section {
            background-color: #f8f8f8;
            padding: 50px 0;
        }

        .service-card {
            text-align: center;
            padding: 20px;
            background-color: white;
            border-radius: 15px;
            transition: all 0.3s;
            height: 100%;
            border: 2px solid transparent;
            cursor: pointer;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            border-color: var(--hasaki-green);
        }

        .service-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 15px;
            background-color: #f0f0f0;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .service-card:hover .service-icon {
            background-color: var(--hasaki-green);
            transform: scale(1.1);
        }

        .service-icon i {
            font-size: 35px;
            color: #333;
            transition: color 0.3s;
        }

        .service-card:hover .service-icon i {
            color: white;
        }

        .service-title {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            margin-top: 10px;
        }

        /* FAQ Section */
        .faq-section {
            background-color: white;
            padding: 60px 0;
        }

        .section-title {
            font-size: 28px;
            font-weight: bold;
            color: #333;
            margin-bottom: 40px;
        }

        .faq-item {
            padding: 15px 0;
            border-bottom: 1px solid #e0e0e0;
            cursor: pointer;
            transition: all 0.3s;
        }

        .faq-item:hover {
            padding-left: 10px;
            color: var(--hasaki-green);
        }

        .faq-item::before {
            content: '•';
            margin-right: 10px;
            font-size: 20px;
            color: var(--hasaki-green);
        }

        /* Info Section */
        .info-section {
            background-color: #f8f8f8;
            padding: 60px 0;
        }

        .info-column h5 {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            margin-bottom: 20px;
        }

        .info-link {
            display: block;
            padding: 8px 0;
            color: #666;
            text-decoration: none;
            transition: all 0.3s;
        }

        .info-link:hover {
            color: var(--hasaki-green);
            padding-left: 10px;
        }

    @@media (max-width: 768px) {
            .hero-title {
                font-size: 24px;
            }

            .service-card {
                margin-bottom: 15px;
            }

            .contact-buttons {
                flex-direction: column;
                align-items: center;
            }
        }
</style>


<div class="container" style="margin-top:120px;">
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container hero-content">
            <h1 class="hero-title">Xin chào! Chúng tôi có thể giúp gì cho bạn?</h1>

            <!-- Search Box -->
            @using (Html.BeginForm("TimKiemTheoTen", "Home", FormMethod.Post, new {name="name"}))
            {
                <div class="search-box">
                    <input type="text"
                           class="form-control search-input"
                           placeholder="Nhập từ khóa để tìm sản phẩm, thương hiệu bạn mong muốn. Ví dụ: Hasaki" 
                           name="name">
                    <button class="search-btn" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            }

            <!-- Contact Buttons -->
            <div class="contact-buttons">
                <a href="tel:18006324" class="contact-btn">
                    <i class="bi bi-telephone-fill"></i>
                    <span>1800 6324 <small>(Miễn phí)</small></span>
                </a>
                <a href="#chat" class="contact-btn">
                    <i class="bi bi-chat-dots-fill"></i>
                    <span>Chat</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services-section">
