                    FLASH SALE
                </div>


            </div>
            <div class="flash-deal-timer">
                <div class="item">
                    <p class="flash-deal-timer-time" id="days">Days</p>

                </div>
                <div class="item">
                    <p class="flash-deal-timer-time" id="hours">Hours</p>

                </div>
                <div class="item">
                    <p class="flash-deal-timer-time" id="minutes">Minutes</p>

                </div>
                <div class="item">
                    <p class="flash-deal-timer-time" id="seconds">Seconds</p>

                </div>
            </div>

            <p class="end">Chương trình Sale đã kết thúc</p>


        </div>
    </div>

