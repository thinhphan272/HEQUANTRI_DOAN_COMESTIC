<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Cấu hình biến
        const modal = document.getElementById("reviewModal");
        const openBtn = document.querySelector(".product-detail-add-new-rating-button"); // Class nút "Viết đánh giá" trong code cũ của bạn
        const closeBtn = document.getElementById("btnCloseModal");
        const stars = document.querySelectorAll(".star-item");
        const ratingText = document.getElementById("rating-text");

        // Text hiển thị tương ứng số sao
        const ratingLabels = ["", "Rất tệ", "Tệ", "Bình thường", "Hài lòng", "Rất hài lòng"];

        // 2. Xử lý Mở/Đóng Modal
        if (openBtn) {
            openBtn.addEventListener("click", function (e) {
                e.preventDefault(); // Ngăn chặn hành vi mặc định nếu có
                modal.style.display = "flex";
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener("click", function () {
                modal.style.display = "none";
            });
        }

        // Đóng khi click ra ngoài vùng trắng
        window.addEventListener("click", function (e) {
            if (e.target == modal) {
                modal.style.display = "none";
            }
        });

        // 3. Xử lý Chọn Sao
        stars.forEach(star => {
            // Hiệu ứng hover
            star.addEventListener("mouseover", function () {
                const value = parseInt(this.getAttribute("data-value"));
                highlightStars(value, 'hover');
            });

            // Xóa hiệu ứng hover khi chuột rời đi (trở về trạng thái đã chọn)
            star.addEventListener("mouseout", function () {
                resetStars();
            });

            // Xử lý click chọn
            star.addEventListener("click", function () {
                const value = parseInt(this.getAttribute("data-value"));
                // Lưu trạng thái active
                stars.forEach(s => s.classList.remove("active"));
                for (let i = 0; i < value; i++) {
                    stars[i].classList.add("active");
                }
                // Cập nhật text
                ratingText.innerText = ratingLabels[value];
            });
        });

        function highlightStars(value, className) {
            stars.forEach(s => s.classList.remove(className));
            for (let i = 0; i < value; i++) {
                stars[i].classList.add(className);
            }
        }

        function resetStars() {
            stars.forEach(s => s.classList.remove('hover'));
        }

        // Mặc định chọn 5 sao khi mở lên
        stars[4].click();
    });
</script>