<!--Xử lý hình thức thanh toán-->
<script>
    // Lắng nghe sự kiện click vào nút "Tiếp tục" trong modal
    document.getElementById('btnConfirmPayment').addEventListener('click', function () {
        // 1. Tìm radio button đang được chọn
        var selectedOption = document.querySelector('input[name="paymentMethod"]:checked');

        if (selectedOption) {
            // 2. Lấy dữ liệu từ data attribute
            var paymentName = selectedOption.getAttribute('data-name');
            var paymentImgSrc = selectedOption.getAttribute('data-img');

            // 3. Cập nhật giao diện trang PaymentPage
            // Cập nhật tên phương thức 
            var labelElement = document.querySelector('#selectedPaymentMethod .form-of-payment-choice-label');
            if (labelElement) labelElement.innerText = paymentName;

            // Cập nhật hình ảnh 
            var imgElement = document.querySelector('#selectedPaymentMethod img');
            if (imgElement) imgElement.src = paymentImgSrc;

            // 4. Đóng modal
            var modalElement = document.getElementById('paymentMethodModal');
            var modalInstance = bootstrap.Modal.getInstance(modalElement);
            modalInstance.hide();
        }
    });
</script>

<!--Xử lý mã giảm giá-->
<script>
    // Xử lý khi nhấn nút Tiếp tục ở modal mã giảm giá
    document.getElementById('btnConfirmDiscount').addEventListener('click', function () {
        var discountCode = document.getElementById('discountInput').value;
        var displayLabel = document.querySelector('.type-discount-code');

        if (discountCode.trim() !== "") {
            // Nếu có nhập mã thì hiển thị mã đó và đổi màu
            displayLabel.innerText = discountCode;
            displayLabel.style.color = "var(--primary-color)";
            displayLabel.style.fontWeight = "bold";
        } else {
            // Nếu để trống thì trả về mặc định
            displayLabel.innerText = "Nhập mã giảm giá";
            displayLabel.style.color = "";
            displayLabel.style.fontWeight = "";
        }
    });
</script>


<!--Xử lý form thêm địa chỉ mới-->
<script>
    document.querySelectorAll('input[name="addressType"]').forEach((elem) => {
        elem.addEventListener("change", function (event) {
            var labels = document.querySelectorAll('label[for^="type"]');
            // Reset style tất cả về màu xám
            labels.forEach(l => {
                l.style.backgroundColor = "#e9ecef";
                l.style.color = "black";
            });

            // Set style cho nút được chọn thành màu xanh
            var selectedLabel = document.querySelector(`label[for="${event.target.id}"]`);
            selectedLabel.style.backgroundColor = "var(--primary-color)";
            selectedLabel.style.color = "white";
        });
    });
</script>

<!--Xử lý nút Nhà riêng/Công ty ở form sửa sản phẩm-->
<script>
    document.querySelectorAll('input[name="addressTypeEdit"]').forEach((elem) => {
        elem.addEventListener("change", function (event) {
            // 1. Lấy 2 cái nhãn (label) của form Sửa
            var homeLabel = document.querySelector('label[for="editTypeHome"]');
            var companyLabel = document.querySelector('label[for="editTypeCompany"]');

            // 2. Reset cả 2 về màu xám (màu không chọn)
            [homeLabel, companyLabel].forEach(l => {
                l.style.backgroundColor = "#e9ecef"; // Màu nền xám
                l.style.color = "black";             // Chữ đen
            });

            // 3. Tìm nhãn vừa được bấm và tô màu xanh
            var selectedLabel = document.querySelector(`label[for="${event.target.id}"]`);
            selectedLabel.style.backgroundColor = "var(--primary-color)"; // Màu xanh chủ đạo
            selectedLabel.style.color = "white";                          // Chữ trắng
        });
    });
</script>