
@{
    ViewBag.Title = "UpdateDonHang";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}
<style>

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .page-header h1 {
            font-size: 1.8rem;
            color: #2c3e50;
            font-weight: 700;
            margin: 0;
        }

        .page-header .btn-back {
            background: white;
            color: #2d5f4f;
            border: 2px solid #2d5f4f;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .page-header .btn-back:hover {
                background: #2d5f4f;
                color: white;
            }

    /* Form Card */
    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #2d5f4f 0%, #1a3d32 100%);
        padding: 20px 25px;
        color: white;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .card-header-custom h3 {
            font-size: 1.2rem;
            font-weight: 700;
            margin: 0;
        }

        .card-header-custom i {
            font-size: 1.3rem;
        }

    .card-body-custom {
        padding: 30px;
    }

    /* Form Groups */
    .form-label-custom {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .form-label-custom .required {
            color: #dc2626;
        }

    .form-control-custom {
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 1rem;
        transition: all 0.3s;
    }

        .form-control-custom:focus {
            border-color: #2d5f4f;
            box-shadow: 0 0 0 3px rgba(45, 95, 79, 0.1);
            outline: none;
        }

    .form-select-custom {
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%232d5f4f' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 15px center;
        background-size: 16px;
        padding-right: 45px;
        appearance: none;
    }

        .form-select-custom:focus {
            border-color: #2d5f4f;
            box-shadow: 0 0 0 3px rgba(45, 95, 79, 0.1);
            outline: none;
        }

    textarea.form-control-custom {
        resize: vertical;
        min-height: 100px;
    }

    /* Info Box */
    .info-box {
        background: #f0fdf4;
        border-left: 4px solid #10b981;
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .info-box i {
            color: #10b981;
            margin-right: 10px;
        }

    .warning-box {
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

        .warning-box i {
            color: #f59e0b;
            margin-right: 10px;
        }

    /* Order Summary */
    .order-summary {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .summary-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .summary-row:last-child {
            border-bottom: none;
        }

    .summary-label {
        color: #6c757d;
    }

    .summary-value {
        font-weight: 600;
        color: #2c3e50;
    }

    /* Product List */
    .product-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        margin-bottom: 10px;
    }

    .product-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
    }

    .product-details {
        flex: 1;
    }

    .product-name {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .product-meta {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .product-price {
        font-weight: 700;
        color: #2d5f4f;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: flex-end;
        padding-top: 20px;
        border-top: 2px solid #e5e7eb;
        margin-top: 30px;
    }

    .btn-custom {
        padding: 14px 28px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
        font-size: 1rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #2d5f4f 0%, #1a3d32 100%);
        color: white;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(45, 95, 79, 0.3);
        }

    .btn-success-custom {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }

        .btn-success-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
        }

    .btn-danger-custom {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

    .btn-outline-custom {
        background: white;
        color: #6c757d;
        border: 2px solid #e5e7eb;
    }

        .btn-outline-custom:hover {
            background: #f8f9fa;
            border-color: #d1d5db;
        }

    /* Status Selection Cards */
    .status-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
    }

    .status-card {
        padding: 20px;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
    }

        .status-card:hover {
            border-color: #2d5f4f;
            box-shadow: 0 4px 12px rgba(45, 95, 79, 0.1);
        }

        .status-card.selected {
            border-color: #2d5f4f;
            background: #f0fdf4;
        }

        .status-card input[type="radio"] {
            display: none;
        }

        .status-card i {
            font-size: 2rem;
            margin-bottom: 10px;
            display: block;
        }

        .status-card .status-name {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .status-card .status-desc {
            font-size: 0.85rem;
            color: #6c757d;
        }

    @@media (max-width: 992px) {
        .sidebar {
            transform: translateX(-100%);
        }

        .main-content {
            margin-left: 0;
        }
    }

    @@media (max-width: 768px) {
        .content-wrapper {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-custom {
            width: 100%;
            justify-content: center;
        }

        .status-cards {
            grid-template-columns: 1fr;
        }
    }
</style>

@model DoAnHQT_DATABASE.Models.Orders


    <!-- Content -->
    <div class="content-wrapper">
        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h1 class="text-white">Cập nhật Đơn hàng @Model.OrderID</h1>
                <small style="color: #6c757d;color:white;">Ngày đặt: @Model.OrderDate</small>
            </div>
            <a href="@Url.Action("Index", "Order", new {area="admin"})" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                Quay lại
            </a>
        </div>

        <div class="row">
            <div class="col-lg-7">
                <!-- Update Status -->
                <div class="form-card">
                    <div class="card-header-custom">
                        <i class="fas fa-sync-alt"></i>
                        <h3>Cập nhật Trạng thái Đơn hàng</h3>
                    </div>
                    <div class="card-body-custom">
                        <div class="info-box">
                            <i class="fas fa-info-circle"></i>
                            <strong>Trạng thái hiện tại:</strong> @Model.Status
                        </div>

                        <div class="mb-4">
                            <label class="form-label-custom">
                                Chọn trạng thái mới <span class="required">*</span>
                            </label>
                            <div class="status-cards ">
                                @using (Html.BeginForm("UpdateOnSubmit", "Order", FormMethod.Post, new { area = "admin" }))
                                {
                                    <input type="text" name="orderID" hidden value="@Model.OrderID" />
                                    <label class="status-card ">
                                        <input type="radio" name="status" value="Chờ xác nhận">
                                        <i class="fas fa-clock" style="color: #f59e0b;"></i>
                                        <div class="status-name">Chờ xác nhận</div>
                                        <div class="status-desc">Đơn hàng mới</div>
                                    </label>

                                    <label class="status-card ">
                                        <input type="radio" name="status" value="Đã xác nhận">
                                        <i class="fas fa-check-circle" style="color: #3b82f6;"></i>
                                        <div class="status-name">Đã xác nhận</div>
                                        <div class="status-desc">Đã xác nhận đơn</div>
                                    </label>

                                    <label class="status-card">
                                        <input type="radio" name="status" value="Đang đóng gói">
                                        <i class="fas fa-box" style="color: #8b5cf6;"></i>
                                        <div class="status-name">Đang đóng gói</div>
                                        <div class="status-desc">Chuẩn bị hàng</div>
                                    </label>

                                    <label class="status-card ">
                                        <input type="radio" name="status" value="Đang vận chuyển" checked>
                                        <i class="fas fa-shipping-fast" style="color: #06b6d4;"></i>
                                        <div class="status-name">Đang vận chuyển</div>
                                        <div class="status-desc">Đang giao hàng</div>
                                    </label>

                                    <label class="status-card ">
                                        <input type="radio" name="status" value="Đã giao hàng">
                                        <i class="fas fa-check-double" style="color: #10b981;"></i>
                                        <div class="status-name">Đã giao hàng</div>
                                        <div class="status-desc">Hoàn thành</div>
                                    </label>

                                    <label class="status-card ">
                                        <input type="radio" name="status" value="Đã hủy">
                                        <i class="fas fa-times-circle" style="color: #ef4444;"></i>
                                        <div class="status-name">Đã hủy</div>
                                        <div class="status-desc">Hủy đơn hàng</div>
                                    </label>
                                    <br />
                                    <button type="submit" class="mt-3 btn btn-primary">Save</button>
                                }
                            </div>

                        </div>
                    </div>

                    <!-- Payment Info -->
                    <div class="form-card mt-3">
                        <div class="card-header-custom">
                            <i class="fas fa-credit-card"></i>
                            <h3>Thông tin Thanh toán</h3>
                        </div>
                        <div class="card-body-custom">
                            <div class="warning-box mb-3">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>Lưu ý:</strong> Đơn hàng này sử dụng phương thức thanh toán COD
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label-custom">Phương thức thanh toán</label>
                                    <input type="text" class="form-control-custom" value="COD - Thanh toán khi nhận hàng" readonly>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>


            </div>

            <div class="col-lg-4">
                <!-- Order Summary -->
                <div class="form-card">
                    <div class="card-header-custom">
                        <i class="fas fa-file-invoice"></i>
                        <h3>Thông tin Đơn hàng</h3>
                    </div>
                    <div class="card-body-custom">
                        <div class="order-summary">
                            <div class="summary-title">
                                <i class="fas fa-info-circle"></i>
                                Chi tiết
                            </div>
                            <div class="summary-row">
                                <span class="summary-label">Mã đơn:</span>
                                <span class="summary-value">@Model.OrderID</span>
                            </div>
                            <div class="summary-row">
                                <span class="summary-label">Khách hàng:</span>
                                <span class="summary-value">@Model.Users.Name</span>
                            </div>
                            <div class="summary-row">
                                <span class="summary-label">Số điện thoại:</span>
                                <span class="summary-value">@Model.Users.SDT</span>
                            </div>
                            <div class="summary-row">
                                <span class="summary-label">Tổng tiền:</span>
                                <span class="summary-value" style="color: #2d5f4f; font-size: 1.1rem;">@Model.TongThanhTien.ToString("N0")đ</span>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="summary-title">
                                <i class="fas fa-box-open"></i>
                                Sản phẩm (@Model.OrderDetail.Count())
                            </div>
                            @foreach (var item in Model.OrderDetail)
                            {
                                <div class="product-item">
                                    <img src="@Url.Content("~/Content/Images/ProductIMG/" + item.Product.Image)" alt="Product" class="product-image">
                                    <div class="product-details">
                                        <div class="product-name">@item.Product.ProductName</div>
                                        <div class="product-meta">SL: @item.Quantity × @item.UnitPrice.Value.ToString("N0")đ</div>
                                    </div>
                                    <div class="product-price">@item.TongTien.ToString("N0")đ</div>
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="form-card">
                    <div class="card-header-custom">
                        <i class="fas fa-bolt"></i>
                        <h3>Thao tác Nhanh</h3>
                    </div>
                    <div class="card-body-custom">
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("ChiTietDonHang", "Order", new {orderID = Model.OrderID})" class="btn-custom btn-primary-custom">
                                <i class="fas fa-eye"></i>
                                Xem chi tiết đơn hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        // Lấy tất cả các radio button trong status-card
        const radios = document.querySelectorAll('.status-card input[type="radio"]');

        // Hàm cập nhật giao diện
        function updateStatusUI() {
            // Xóa class selected ở tất cả các card
            document.querySelectorAll('.status-card').forEach(card => {
                card.classList.remove('selected');
            });

            // Thêm class selected cho card chứa radio đang được check
            const checkedRadio = document.querySelector('.status-card input[type="radio"]:checked');
            if (checkedRadio) {
                checkedRadio.closest('.status-card').classList.add('selected');
            }
        }

        // Gán sự kiện click cho từng radio
        radios.forEach(radio => {
            radio.addEventListener('change', updateStatusUI);
        });

        // Chạy 1 lần khi trang vừa load để hiển thị trạng thái hiện tại
        updateStatusUI();
    });
    </script>