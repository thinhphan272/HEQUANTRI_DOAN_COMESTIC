
@{
    ViewBag.Title = "SanPhamDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>SanPhamDetail</h2>

<div class="product-detail-container">
    <div class="" style="width: 1300px; margin: 0 auto">
        <div class="row">
            <div class="col-md-9 product-detail shadow">
                <div class="row">
                    <div class="col-md-5 product-detail-image">
                        <div class="main-img">
                            <img  id="mainImage" width="100%" src="~/Content/Images/ProductIMG/SuaRuaMat/SRMLaRoChePoSay.png" />

                        </div>

                       
                    </div>
                    <div class="col-md-7 product-detail-content">
                        <div class="brand-and-ship">
                            <div class="now-free-img">
                                <img height="100%" class="now-free-img-image" src="~/Content/Images/SanPhamDetailIMG/now_free.png"/>

                            </div>
                            <div class="product-detail-brand ms-2">
                                LA ROCHE-POSAY
                            </div>

                        </div>
                        <div class="product-detail-name">
                            Gel Rửa Mặt La Roche-Posay Dành Cho Da Dầu, Nhạy Cảm 400ml
                        </div>
                        <div class="rating-group">
                            <div class="star-average">
                                <span>4.9</span>

                                <i class="fa fa-star ms-1" style="font-size: 0.8rem"></i>
                            </div>

                            <div class="total-rating ms-1">
                                142 đánh giá
                            </div>
                            <div class="rating-group-divide ms-1" >

                                |
                            </div>
                            <div class="product-detail-id ms-1">
                                Mã sản phẩm: 204900056
                            </div>
                        </div>

                        <div class="product-detail-price">
                            <i class="fa fa-money-bill-1-wave" style="color: var(--primary-color)"></i>
                            <span class="product-detail-price-money">430.000 đ</span>
                            <span class="product-detail-price-VAT">(Đã bao gồm VAT) </span>
                        </div>
                        <div class="product-detail-capacity">
                            Dung tích:
                            <span class="product-detail-capacity-value">400ml</span>
                        </div>

                        <div class="product-detail-change_quantity mt-2">
                            <span class="product-detail-change_quantity-label me-1">
                                Số lượng: 
                            </span>
                            <i class="fa fa-minus-circle me-1" style="color: #306e51"></i>
                            
                            <div class="product-detail-quantity-value me-1">
                                1
                            </div>
                            <i class="fa fa-plus-circle" style="color: #306e51"></i>
                        </div>

                        <div class="brand-and-ship">
                            <div class="now-free-img">
                                <img height="100%" class="now-free-img-image" src="~/Content/Images/SanPhamDetailIMG/now_free.png" />

                            </div>
                            <div class="product-detail-brand ms-2" style="color: black">
                                Giao nhanh miễn phí 2H
                            </div>

                        </div>
                        <div class="product-detail-shipping-info">
                            Bạn muốn nhận hàng trước <span style="color: #f60">20h</span> hôm nay (<span style="color: #f60; font-weight: bold">Miễn phí</span>). 
                            Đặt hàng trong <span style="color: #f60">1 giờ 35 phút</span> tới và chọn giao hàng <span style="color: #f60">2H</span> ở bước thanh toán.
                        </div>
                        <div class="button-add-product-to-cart mt-2">
                            <button class="btn" style="background-color: #306e51; color: white; height: 50px; font-weight: bold"><i class="fa fa-cart-plus"></i> Thêm vào giỏ hàng</button>
                            <button class="btn"  style="background-color: #306e51; font-size: 0.8rem; color: white; height: 50px; padding: 5px; font-weight: bold">MUA NGAY NOW FREE 2H<br /><span style="font-size: 0.9rem; margin-top: -30px; font-weight: 400">Trễ tặng 100k</span></button>
                        </div>
                    </div>
                </div>

                <div class="row">

                </div>
            </div>

            <div class="col-md-3 product-detail-delivery shadow ms-4">
                <div class="product-detail-delivery-div">
                    <div class="product-detail-delivery-header">
                        <i class="fa-solid fa-minus"></i>
                         MIỄN PHÍ VẬN CHUYỂN 
                        <i class="fa-solid fa-minus"></i>
                    </div>
                    <div class="now-2h-delivery">
                        <div class="now-2h-delivery-img">
                            <img height="100%" src="~/Content/Images/SanPhamDetailIMG/now-free-2h.png" />
                        </div>
                        <div class="now-2h-delivery-label ms-2">
                            Giao Nhanh Miễn Phí 2H. <b>Trễ tặng 100K</b>
                        </div>
                    </div>
                    <div class="now-2h-delivery">
                        <div class="now-2h-delivery-img">
                            <img height="100%" src="~/Content/Images/SanPhamDetailIMG/chinh_hang.png" />
                        </div>
                        <div class="now-2h-delivery-label ms-2">
                            Hasaki đền bù <b>100%</b> hãng đền bù <b>100%</b> nếu phát hiện hàng giả
                        </div>
                    </div>
                    <div class="now-2h-delivery">
                        <div class="now-2h-delivery-img">
                            <img height="100%" src="~/Content/Images/SanPhamDetailIMG/free_ship_48h.png" />
                        </div>
                        <div class="now-2h-delivery-label ms-2">
                            <b>Giao Hàng Miễn Phí</b> (từ 90K tại 60 Tỉnh Thành trừ huyện, toàn Quốc từ 249K)
                        </div>
                    </div>
                    <div class="now-2h-delivery">
                        <div class="now-2h-delivery-img">
                            <img height="100%" src="~/Content/Images/SanPhamDetailIMG/doi_tra30.png" />
                        </div>
                        <div class="now-2h-delivery-label ms-2">
                            Đổi trả<br />
                            trong <b>30 ngày</b>
                        </div>
                    </div>
                </div>
                

            </div>

        </div>

        <div class="row">
            <div class="col-md-9 rating-container shadow mt-4">
                <div class="rating-container-header">
                    Đánh giá (142)
                </div>
            </div>
            <div class="col-md-3">

            </div>
        </div>
    </div>

</div>
