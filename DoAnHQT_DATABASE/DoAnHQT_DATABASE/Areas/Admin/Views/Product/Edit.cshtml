
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";

}

@model DoAnHQT_DATABASE.Models.Product

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tiny.cloud/1/ntjn1x7xodddb5xd6aojdl4pncz9ufjf77rzij4cz6ooerjt/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>


<div class="container-fluid px-4">
    @if (TempData["UpdateError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["UpdateError"].ToString()
        </div>
    }
    @if (TempData["DisableError"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["DisableError"].ToString()
        </div>
    }
    @if (TempData["DisableSuccess"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["DisableSuccess"].ToString()
        </div>
    }

    <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="mt-4">Chỉnh sửa sản phẩm</h2>
        <a href="@Url.Action("Index", "Product", new {area = "Admin"})" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <i class="fas fa-pencil-alt me-1"></i>
            Thông tin sản phẩm
        </div>
        <div class="card-body">
            @using (Html.BeginForm("EditOnSubmit", "Product", new { area = "Admin" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {

                @Html.TextBoxFor(model => model.ProductID, new { type = "hidden" })
                @Html.TextBoxFor(model => model.Image, new { type = "hidden" })

                <div class="row">
                    <div class="col-md-8">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="ProductName" class="form-label fw-bold">Tên sản phẩm</label>
                                @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.ProductName)
                            </div>
                            <div class="col-md-6">
                                <label for="ProductTypeID" class="form-label fw-bold">Loại sản phẩm</label>
                                @Html.DropDownListFor(model => model.ProductTypeID, ViewBag.ProductType as SelectList, new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.ProductTypeID)
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="BrandID" class="form-label fw-bold">Thương hiệu</label>
                                @Html.DropDownListFor(model => model.BrandID, ViewBag.Brand as SelectList, new { @class = "form-select" })
                                @Html.ValidationMessageFor(model => model.BrandID)
                            </div>
                            <div class="col-md-6">
                                <label for="Origin" class="form-label fw-bold">Xuất xứ</label>
                                @Html.TextBoxFor(model => model.Origin, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Origin)
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                                @Html.TextBoxFor(model => model.Price, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Price)
                            </div>
                            <div class="col-md-4">
                                <label for="Quantity" class="form-label fw-bold">Số lượng kho</label>
                                @Html.TextBoxFor(model => model.Quantity, new { @class = "form-control", type = "number" })
                                @Html.ValidationMessageFor(model => model.Quantity)
                            </div>
                            <div class="col-md-4">
                                <label for="Capacity" class="form-label fw-bold">Dung tích</label>
                                @Html.TextBoxFor(model => model.Capacity, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.Capacity)
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="txtDescription" class="form-label fw-bold">Mô tả chi tiết</label>
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", id = "txtDescription", rows = "10" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card mb-3">
                            <div class="card-header bg-light fw-bold">Hình ảnh sản phẩm</div>
                            <div class="card-body text-center">
                                <img src="@Url.Content("~/Content/Images/ProductIMG/" + Model.Image)"
                                     style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;" />

                                <label for="imageUploadFile" class="btn btn-outline-primary btn-sm w-100 mb-2">
                                    <i class="fas fa-upload me-1"></i> Chọn ảnh mới
                                </label>
                                <input type="file" name="ImageUpload" id="imageUploadFile" class="d-none" accept="image/*" onchange="previewImage(this)" />
                                <small class="text-muted">Hỗ trợ: .jpg, .png, .jpeg</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="ExpirationDate" class="form-label fw-bold">Ngày hết hạn</label>
                            @Html.TextBoxFor(model => model.ExpirationDate,
                           "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "ExpirationDate" })
                            @Html.ValidationMessageFor(model => model.ExpirationDate)
                        </div>

                        <div class="card bg-light border-0">
                            <div class="card-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" value="1" id="IsAvailableSwitch" name="IsAvailable" style="cursor: pointer;"
                                           @(Model.IsAvailable == 0 ? "checked" : "")>

                                    <label class="form-check-label fw-bold" for="IsAvailableSwitch">Đang kinh doanh</label>
                                </div>
                                <div class="form-text mt-2" style="font-size: 0.85rem;">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Gạt tắt để ẩn sản phẩm khỏi trang người dùng.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <a href="@Url.Action("Index", "Product", new { area = "Admin" })" class="btn btn-light border me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="fas fa-save me-2"></i>Cập nhật sản phẩm
                    </button>
                </div>

            }
        </div>
    </div>
</div>

<script>
    // 1. Khởi tạo TinyMCE cho textarea có id="txtDescription"
    tinymce.init({
        selector: '#txtDescription',
        plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
        toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
    });

    // 2. Script Preview ảnh khi chọn file
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                // Gán đường dẫn ảnh mới vào thẻ img
                document.getElementById('imgPreview').src = e.target.result;
            }

            reader.readAsDataURL(input.files[0]); // Đọc file ảnh
        }
    }
</script>
