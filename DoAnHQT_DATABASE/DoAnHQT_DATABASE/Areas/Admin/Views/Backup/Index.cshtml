@{
    ViewBag.Title = "Sao lưu và Phục hồi dữ liệu";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
    :root {
        --hasaki-dark: #2d5f4f;
        --hasaki-green: #10b981;
        --hasaki-orange: #f59e0b;
        --text-muted: #6c757d;
        --bg-light: #f8f9fa;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f0f2f5;
    }

    /* --- Page Header --- */
    .page-header {
        background-color: white;
        padding: 1.5rem 2rem;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-title h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--hasaki-dark);
        margin: 0;
    }

    /* --- Card Style --- */
    .custom-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        overflow: hidden;
        border: none;
        height: 100%; /* Để 2 cột cao bằng nhau */
        transition: transform 0.3s ease;
    }

        .custom-card:hover {
            transform: translateY(-5px);
        }

    .card-header-custom {
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        font-weight: 600;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Màu icon header */
    .header-backup {
        color: var(--hasaki-green);
        background-color: #ecfdf5;
        padding: 10px;
        border-radius: 8px;
    }

    .header-restore {
        color: var(--hasaki-orange);
        background-color: #fff7ed;
        padding: 10px;
        border-radius: 8px;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* --- Form Elements --- */
    .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #e9ecef;
        background-color: #f8f9fa;
        padding: 10px 15px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

        .form-control:focus, .form-select:focus {
            background-color: white;
            border-color: var(--hasaki-green);
            box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
        }

    /* --- Buttons --- */
    .btn-action {
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 10px;
    }

    .btn-backup {
        background: linear-gradient(135deg, var(--hasaki-green), #059669);
        color: white;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

        .btn-backup:hover {
            background: #047857;
            color: white;
            transform: translateY(-2px);
        }

    .btn-restore {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
    }

        .btn-restore:hover {
            background: #b45309;
            color: white;
            transform: translateY(-2px);
        }

    /* --- Radio Buttons --- */
    .form-check-input:checked {
        background-color: var(--hasaki-orange);
        border-color: var(--hasaki-orange);
    }
</style>

<div class="container-fluid py-4">

    <div class="page-header">
        <div class="header-icon p-2 rounded-3 bg-light text-primary">
            <i class="fas fa-server fa-2x" style="color: var(--hasaki-dark)"></i>
        </div>
        <div class="page-title">
            <h2>Quản Lý Cơ Sở Dữ Liệu</h2>
            <p class="text-muted mb-0 small">Sao lưu và phục hồi dữ liệu hệ thống (Backup & Restore)</p>
        </div>
    </div>

    @if (ViewBag.BackupSuccess != null)
    {
        <div class="alert alert-success shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center">
            <i class="fas fa-check-circle me-2 fs-4"></i>
            <div>@ViewBag.BackupSuccess</div>
        </div>
    }
    @if (ViewBag.BackupError != null)
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-3 mb-4 d-flex align-items-center">
            <i class="fas fa-exclamation-triangle me-2 fs-4"></i>
            <div>@ViewBag.BackupError</div>
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="custom-card">
                <div class="card-header-custom">
                    <i class="fas fa-save header-backup"></i>
                    <span style="color: var(--hasaki-dark)">Sao Lưu Dữ Liệu (Backup)</span>
                </div>
                <div class="card-body-custom">
                    @using (Html.BeginForm("BackUpOnSubmit", "Backup", FormMethod.Post))
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="backupType" class="form-label">Loại Backup</label>
                                <select class="form-select" id="backupType" name="backupType" required>
                                    <option value="">-- Chọn loại --</option>
                                    <option value="full" selected>Full Backup</option>
                                    <option value="differential">Differential Backup</option>
                                    <option value="log">Transaction Log</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="databaseName" class="form-label">Tên Database</label>
                                <input type="text" class="form-control" id="databaseName" name="databaseName" value="QL_BANHANG_ONLINE" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Đường dẫn lưu file</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-folder-open text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" id="backupPath" name="backupPath" placeholder="Ví dụ: C:\Backups\Hasaki_Full.bak" required>
                            </div>
                            <div class="form-text small"><i class="fas fa-info-circle me-1"></i>Đảm bảo SQL Server có quyền ghi vào thư mục này.</div>
                        </div>

                        <div class="mb-4">
                            <label for="backupDescription" class="form-label">Mô tả (Tùy chọn)</label>
                            <textarea class="form-control" id="backupDescription" rows="3" placeholder="Ghi chú cho bản backup này..."></textarea>
                        </div>

                        <button type="submit" class="btn-action btn-backup">
                            <i class="fas fa-cloud-upload-alt"></i> Tiến Hành Backup
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="custom-card">
                <div class="card-header-custom">
                    <i class="fas fa-undo header-restore"></i>
                    <span style="color: #b45309">Phục Hồi Dữ Liệu (Restore)</span>
                </div>
                <div class="card-body-custom">
                    @using (Html.BeginForm("RestoreOnSubmit", "Backup", FormMethod.Post))
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="restoreType" class="form-label">Loại Restore</label>
                                <select class="form-select" id="restoreType" required name="restoreType">
                                    <option value="">-- Chọn loại --</option>
                                    <option value="full" selected>Full Restore</option>
                                    <option value="differential">Differential Restore</option>
                                    <option value="log">Transaction Log</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="restoreDatabaseName" class="form-label">Database Đích</label>
                                <input type="text" class="form-control" id="restoreDatabaseName" name="restoreDatabaseName" value="QL_BANHANG_ONLINE" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nguồn file Backup</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-file-import text-muted"></i></span>
                                <input type="text" class="form-control border-start-0 ps-0" id="restorePath" name="restorePath" placeholder="Ví dụ: C:\Backups\Hasaki_Full.bak" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="fileNumber" class="form-label">File Number</label>
                            <input type="number" class="form-control" id="fileNumber" name="fileNumber" value="1" min="1">
                        </div>

                        <div class="p-3 bg-light rounded-3 mb-4 border">
                            <label class="form-label mb-2">Chế độ phục hồi</label>
                            <div class="form-check mb-2">
                                <input type="radio" class="form-check-input" id="overwriteDatabase" name="recovery" value="1" checked>
                                <label class="form-check-label text-dark" for="overwriteDatabase">
                                    <strong>RECOVERY:</strong> Phục hồi hoàn tất, DB sẵn sàng sử dụng.
                                </label>
                            </div>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" id="noRecovery" name="recovery" value="2">
                                <label class="form-check-label text-dark" for="noRecovery">
                                    <strong>NORECOVERY:</strong> Chờ restore thêm (Differential/Log).
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn-action btn-restore" onclick="return confirm('CẢNH BÁO: Hành động này sẽ ghi đè dữ liệu hiện tại. Bạn có chắc chắn muốn tiếp tục?');">
                            <i class="fas fa-history"></i> Tiến Hành Restore
                        </button>
                    }
                </div>
            </div>
        </div>

    </div>
</div>