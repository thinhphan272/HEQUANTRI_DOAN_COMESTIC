@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<DoAnHQT_DATABASE.Models.Product>

<div class="app_container" style="margin-top:123px;">
    <div class="" style="width: 1300px; margin: 0 auto">
        <div class="grid_row app_content">

            <div class="grid_column-2">
                @Html.Action("HienThiDanhMuc", "Home")
            </div>

            <!--Lọc-->
            <div class="grid_column-10">
                <div class="home-filter">
                    <span class="home-filter_label">Sắp xếp theo</span>
                    @*<button class="btn home-filter-btn">Phổ biến</button>*@
                    <a href="@Url.Action("SapXepMoiNhat", "Home")" class="btn home-filter-btn home-filter-btn-primary" style="background-color:var(--primary-color); color: white">Mới nhất</a>
                    <a href="@Url.Action("SapXepBanChay", "Home")" class="btn home-filter-btn">Bán chạy</a>

                    <div class="select-input">
                        <span class="select-input_label">Giá</span>
                        <i class="select-input_icon fa fa-angle-down"></i>
                        <ul class="select-input_list">
                            <li class="select-input_item">
                                <a href="@Url.Action("SapXepGia", "Home", new {order=1})" class="select-input_link">Giá: Thấp đến cao</a>
                            </li>
                            <li class="select-input_item">
                                <a href="@Url.Action("SapXepGia", "Home", new {order=-1})" class="select-input_link">Giá: Cao đến thấp</a>
                            </li>
                        </ul>
                    </div>
                    <div class="home-filter_page">
                        <span class="home-filter_page-num">
                            <span class="home-filter_page-current">
                                1
                            </span>/14

                        </span>

                        <div class="home-filter_page-control">
                            <a href="" class="home-filter_page-btn home-filter_page-btn-disable">
                                <i class="home-filter_page-icon fa fa-angle-left"></i>
                            </a>
                            <a href="" class="home-filter_page-btn">
                                <i class="home-filter_page-icon fa fa-angle-right"></i>
                            </a>

                        </div>
                    </div>
                </div>

                <div class="home-product">
                    <div class="grid_row">
                        <!--Card-->
                        @foreach (var item in Model)
                        {
                                <div class="grid_column-2-4">
                                    <!--home-product-->
                                    <a href="@Url.Action("SanPhamDetail", "Home", new {id = item.ProductID.Trim()})" class="home-product-item card">
                                        <div class="home-product-item_img-div ">
                                            <img src="@Url.Content("~/Content/Images/ProductIMG/" + item.Image)" class="card-img-top home-product-item_img" />

                                        </div>
                                        <div class="card-body">
                                            <div class="home-product-item_origin">
                                                <span class="home-product-item_brand">
                                                    @item.Brand.BrandName
                                                </span>
                                                <span class="home-product-item_origin-name">@item.Origin</span>
                                            </div>
                                            <p class="home-product-item_name">@item.ProductName</p>
                                            <div class="home-product-item_price">
                                                @{if (item.GiaDaGiam != (double)item.Price)
                                                    {
                                                        decimal mucGiam = item.Discount.Count() != 0 ? (decimal)item.Discount.ToList()[0].DiscountRate : 0;
                                                        decimal tienSauGiam = item.Price.Value * (100 - mucGiam) / 100;
                                                        <span class="home-product-item_price-old">@item.Price.Value.ToString("N0")đ</span>
                                                        <span class="home-product-item_price-current">@tienSauGiam.ToString("N0")đ</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="home-product-item_price-current">@item.Price.Value.ToString("N0")đ</span>
                                                    }
                                                }
                                            </div>

                                            <div class="home-product-item_action">
                                                <span class="home-product-item_like home-product-item_like-liked">
                                                    <i class="home-product-item_like-icon-empty fa-regular fa-heart"></i>
                                                    <i class="home-product-item_like-icon-fill fa fa-heart"></i>
                                                </span>
                                                <div class="home-product-item_rating">
                                                    @{
                                                        if (item.Rating.Count() != 0)
                                                        {
                                                            int avgStars = (int)item.Rating.Average(t => t.Star);
                                                            for (int i = 0; i < avgStars; i++)
                                                            {
                                                                <i class="home-product-item_star-gold fa fa-star"></i>
                                                            }
                                                        }

                                                    }

                                                </div>


                                                @{
                                                    int spDaBan = 0;
                                                    if (item.OrderDetail != null)
                                                    {
                                                        spDaBan = item.OrderDetail.Count();
                                                        <span class="home-product-item_sold">
                                                            @spDaBan đã bán
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="home-product-item_sold">
                                                            @spDaBan đã bán
                                                        </span>
                                                    }
                                                }
                                            </div>

                                            <div class="home-product-item_favourite">
                                                <i class="fa fa-check"></i>
                                                Yêu thích
                                            </div>
                                            <div class="home-product-item_sale-off">
                                                @if (item.Discount.Count() != 0)
                                                {
                                                    <span class="home-product-item_sale-off-percent">@item.Discount.ToList()[0].DiscountRate.ToString()%</span>
                                                    <span class="home-product-item_sale-off-label">GIẢM</span>
                                                }

                                            </div>
                                        </div>
                                    </a>
                                </div>
                            
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

